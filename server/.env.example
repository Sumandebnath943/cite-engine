# ── Database ─────────────────────────────────────────────────────────────
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
#
# For Production (Supabase PostgreSQL):
# 1. Go to supabase.com → New Project → Project Settings → Database
# 2. Copy the "URI" connection string
# 3. Replace the DATABASE_URL above with:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
# 4. Update schema.prisma: change provider = "sqlite" to provider = "postgresql"
# 5. Run: npx prisma migrate dev --name init

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET="cite-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="cite-refresh-secret-change-this-too-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── AI (OpenAI) ───────────────────────────────────────────────────────────
# Get key at: platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── News API (for Job Radar live news) ───────────────────────────────────
# Get key at: newsapi.org (free tier: 100 req/day)
NEWSAPI_KEY=your_newsapi_key_here
NEWS_API_KEY=your_newsapi_key_here
